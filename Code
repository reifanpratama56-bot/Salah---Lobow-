import sys
import time

def jalanin_lirik():
    lirik = [
        ("Apa aku pernah mengeluh? ", 0.12, 0.8),
        ("Apa aku pernah berlari? ", 0.12, 1),
        ("Saat kau ada masalah ", 0.2, 2),
        ("Apa aku pernah mendua? ", 0.12, 0.8),
        ("Apa aku tak mengimbangimu? ", 0.12, 1),
        ("Sayang ", 0.14, 0.1),
        
    ]

    print("\n== Salah - Lobow ==")
    time.sleep(0.1)

    for baris_lagu, delay_karakter, delay_setelah in lirik:

        # Efek mengetik per karakter
        for karakter in baris_lagu:
            print(karakter, end="")
            sys.stdout.flush()
            time.sleep(delay_karakter)

        # Jeda mengikuti perpindahan nada/lirik
        time.sleep(delay_setelah)
        print("")

    print("// Code by Fanncode")

jalanin_lirik()
